# ============================================================
# IDENTIFICAÇÃO SERPRO
# ============================================================
# CNPJ do contratante
CNPJ_CONT=00000000000000

# CNPJ do autor/procurador responsável pela assinatura
AUTOR_PEDIDO=00000000000000

# ============================================================
# CREDENCIAIS SERPRO
# ============================================================
CONSUMER_KEY=
CONSUMER_SECRET=

# ============================================================
# CERTIFICADOS DIGITAIS
# ============================================================
# Os certificados MTLS e AUTOR são cadastrados pela tela
# administrativa do sistema.
CERTIFICATE_STORAGE_DIR=certificados_runtime

# Chave Fernet utilizada para criptografar as senhas dos
# certificados armazenadas no banco de dados.
CERTIFICATE_ENCRYPTION_KEY=

# ============================================================
# ARMAZENAMENTO DOS PDFs
# ============================================================
PDF_STORAGE_DIR=pdfs_runtime

# ============================================================
# BANCO DE DADOS DOMÍNIO
# ============================================================
DOMINIO_HOST=
DOMINIO_PORT=2638
DOMINIO_DB=
DOMINIO_USER=
DOMINIO_PASSWORD=

# ============================================================
# POSTGRESQL - SERPRO PARCELAMENTO
# ============================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=serpro_parcelamento
POSTGRES_USER=
POSTGRES_PASSWORD=

SQLALCHEMY_ECHO=false

# ============================================================
# FLASK
# ============================================================
FLASK_SECRET_KEY=COLOQUE_AQUI_SUA_CHAVE
FLASK_HOST=0.0.0.0
FLASK_PORT=8500
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
MAX_UPLOAD_MB=20